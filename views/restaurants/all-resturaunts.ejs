<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Resturants</title>
    <link rel="stylesheet" href="../all-resturanunts-style.css">
  </head>
  <body>
    <%- include('../partials/navbar') %>
    <h1>All Resturants</h1>

    <ol>
    <% for (let restaurant of restaurants) {%>
        <li><a href="/restaurants/<%= restaurant.id  %>"><%= restaurant.name %> <% if(!restaurant.isOpen) { %>
          - Closed
          <% } %></a>
        </li>
        <% } %>
        </ol>
  </body>
</html>
